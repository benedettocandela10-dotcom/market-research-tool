# Reddit script app — see README "Reddit" section
# Create app: https://www.reddit.com/prefs/apps (type: script, redirect: http://localhost:8080)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=market_research/1.0 by u/YOUR_USERNAME

# Etsy: https://developers.etsy.com → My Apps → API key
ETSY_API_KEY=your_etsy_api_key

# eBay: https://developer.ebay.com → App ID (Client ID) + Cert ID (Client Secret)
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_SANDBOX=false

# Optional: https://trendsmcp.ai → free API key (100 req/month)
TRENDS_API_KEY=your_trends_api_key
